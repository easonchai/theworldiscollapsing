# Copy to .env.local (gitignored). Local stack values shown; anvil deploys are deterministic.

# ── chain (browser) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ARENA_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_USDC_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_GATE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ── wallet ───────────────────────────────────────────────────────────────────
# Privy (email login + embedded wallet). When set it wins over the dev wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
# Local anvil key. Refused on chain 84532.
NEXT_PUBLIC_DEV_WALLET_KEY=

# ── gating ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GATE_MODE=checkbox
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=verify

# ── index (markets + positions read from here; unset shows a not-configured state) ──
NEXT_PUBLIC_SUBGRAPH_URL=

# ── server only ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://twic:twic@localhost:5433/twic
# Gate owner (deployer). Signs setVerified in POST /api/verify.
GATE_OWNER_PRIVATE_KEY=
GATE_MODE=checkbox
# World Selfie Check: rp id + the RP signing key IDKit's rp_context is signed with.
WORLD_APP_ID=
WORLD_API_KEY=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=

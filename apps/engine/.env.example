DATABASE_URL=postgresql://twic:twic@localhost:5433/twic
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# anvil account 0
RESOLVER_PRIVATE_KEY=
ARENA_ADDRESS=

# synthetic bettors (pnpm --filter engine bettor). Perpetual by default; --events N to stop after N.
USDC_ADDRESS=
GATE_ADDRESS=
# comma-separated private keys, one per bettor. Never commit real ones.
BETTOR_KEYS=
# the Gate owner (anvil account 0 locally, the deployer on testnet). Also the funder: it tops a
# bettor up with FUND_ETH of native gas whenever the bettor holds less than FUND_MIN_ETH.
GATE_OWNER_PRIVATE_KEY=
FUND_MIN_ETH=0.005
FUND_ETH=0.01
# stake range in whole USDC (log-uniform, so small bets are common), mean gap between bets
# (jittered 0.3x–2x), how many of BETTOR_KEYS to use, and the PRNG seed (default: time-based)
BET_MIN_USDC=1
BET_MAX_USDC=50
BET_INTERVAL_MS=3000
BETTORS=
BETTOR_SEED=

# mode flags (DEMO_MODE, STUB_MODE, ALWAYS_ON, BRANCH_SEAL): 1 or true, case-insensitive, turns one
# on; anything else, unset included, is off
DEMO_MODE=1
ALWAYS_ON=1
CHANNELS=sports,politics,culture,region

# media
MEDIA_STORE=local
MEDIA_DIR=./media
MEDIA_PORT=4000
MEDIA_BASE_URL=http://localhost:4000
# published media kept per channel; older events' files are deleted when an event finishes (local store only)
MEDIA_KEEP=20
# MEDIA_STORE=blob only
BLOB_READ_WRITE_TOKEN=

# authoring + video. STUB_MODE=1 forces canned author + ffmpeg renderer (no OpenRouter);
# it is also the default when OPENROUTER_API_KEY and OPENROUTER_BASE_URL are both unset.
STUB_MODE=1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai
AUTHOR_MODEL=openai/gpt-5-mini
FILLER_MODEL=openai/gpt-5-nano
VIDEO_MODEL=minimax/hailuo-3-max
IMAGE_MODEL=google/gemini-3.1-flash-image
# hard ceiling in USD on everything ever bought from OpenRouter (video, key art, authoring), persisted
# in the database; the engine stops producing and logs "spend cap reached" instead of crossing it
MAX_SPEND_USD=20
# per-image estimate for the key-art still (price not published by OpenRouter)
IMAGE_COST_USD=0.04
# previous event pool state for authoring; skipped when unset
SUBGRAPH_URL=

# local fake OpenRouter (pnpm --filter engine fake)
FAKE_PORT=4100

# branch sealing + Chainlink CRE (day 7 stretch). Off by default; needs MEDIA_STORE=local.
# BRANCH_SEAL_ROOT must equal packages/cre/.env SECRET_BRANCH_SEAL_ROOT, and
# REVEAL_SECRET must equal SECRET_REVEAL_SECRET, or the released key will not open anything.
# Generate with: printf '0x%s\n' "$(openssl rand -hex 32)"
BRANCH_SEAL=0
BRANCH_SEAL_ROOT=
REVEAL_SECRET=
